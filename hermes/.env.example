# Notion integration token (Settings -> My integrations -> Hermes Dispatcher)
NOTION_TOKEN=secret_your_token_here

# Hermes database ID (the 32-character ID in the database URL)
DATABASE_ID=your_database_id_here

# Tier 3 only
WEBHOOK_PORT=5000
MAX_PARALLEL_TASKS=3

# Set ONE of the two below in production, depending on what calls /webhook.

# Shared secret a generic caller (curl, an internal script, Zapier, ...)
# must send as the X-Webhook-Secret header. Generate a real one, e.g.
# `python3 -c "import secrets; print(secrets.token_urlsafe(32))"` - the
# dispatcher refuses to start with this left blank or set to a placeholder.
WEBHOOK_SECRET=

# The verification_token Notion gives you when you register this URL as a
# webhook subscription. Used to verify the X-Notion-Signature HMAC on real
# Notion webhook events. Takes precedence over WEBHOOK_SECRET if both are set.
NOTION_WEBHOOK_SECRET=

# Set to 1 only while completing the one-time Notion webhook subscription
# handshake, then unset it and restart. While unset, /webhook rejects any
# unsigned "verification_token" payload outright - without this, a publicly
# reachable deployment would let anyone repeatedly overwrite the local
# verification-token file or race the real handshake, even after setup.
WEBHOOK_SETUP_MODE=
